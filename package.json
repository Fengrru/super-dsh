{
  "name": "dsh-super",
  "version": "0.1.0",
  "private": true,
  "description": "SuperDSH — a safety-first reliability suite for DeepSeek Harness (dsh): tolerant edits, effects recovery, signed audit, artifacts, tiered memory, error-repair memory, repo map, profiles, locks, knowledge, replay plans, handoff, compaction, reflection, retention, and budget",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "cordis.patch.yml",
    "presets",
    "scripts",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE",
    "docs"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --outfile=dist/index.js",
    "prepare": "bun run build",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "smoke:install": "bun scripts/install-smoke.ts",
    "experiment:patch": "bun experiments/patch-bench.ts",
    "experiment:units": "bun experiments/unit-checks.ts",
    "experiment:agent": "bun experiments/agent-bench.ts",
    "experiment:profiles": "bun experiments/profile-ab-bench.ts",
    "experiment:repo-perf": "bun experiments/repo-map-perf.ts",
    "experiment:repairs": "bun experiments/repairs-ab-bench.ts"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "memory",
    "audit",
    "verification"
  ],
  "author": "Fengrru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fengrru/super-dsh.git"
  },
  "homepage": "https://github.com/Fengrru/super-dsh#readme",
  "bugs": {
    "url": "https://github.com/Fengrru/super-dsh/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
